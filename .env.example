# Scam Bunker works with NO keys: local forensics + the "Investigate with Claude" button (runs the agent team in claude.ai).
# To run the agent team inside Scam Bunker, pick ONE provider:

# A) Free & offline: install Ollama (https://ollama.com), run `ollama pull gemma3` — detected automatically, nothing to set.
# OLLAMA_MODEL=gemma3

# B) Any OpenAI-compatible API (Groq, OpenRouter, LM Studio, Together…)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_VISION=0

# C) Anthropic API
# ANTHROPIC_API_KEY=

# Optional: robust page fetching + web search for corroboration
# FIRECRAWL_API_KEY=

# HOST=127.0.0.1   (set 0.0.0.0 to expose on your network — anyone who can reach it can use your API key)
# PORT=4400

# Optional: wallet lookups in the Subjects workspace (server/osint.js)
# ETHERSCAN_API_KEY=      # Ethereum (free key at etherscan.io); without it ETH shows an explorer link only
# TRONGRID_API_KEY=       # optional, raises TronGrid rate limits (TRON works without a key)
# TRONSCAN_API_KEY=       # optional keyed fallback for TRON
